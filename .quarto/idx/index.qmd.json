{"markdown":{"yaml":{"page-layout":"full"},"containsRefs":false,"markdown":"\n\n<div class=\"welcome-headline\" style=\"font-size: 2.2rem; font-weight: 800; color: #1e1b4b; margin-bottom: 5px;\">\nWelcome to Papillon Engineering\n</div>\n<div class=\"welcome-subheadline\" style=\"font-size: 1.1rem; color: #64748b; margin-bottom: 30px;\">\nPractical Insights into Materials, Circuits, Engineering Science & Empowering the Next Generation of Engineers\n</div>\n\n::: {.grid .align-items-center}\n\n<!-- Expanded text column slightly (from 4 to 5) for better vertical balance -->\n::: {.g-col-12 .g-col-md-5 style=\"background-color: #f8f9fa; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; font-size: 1.05rem; line-height: 1.6;\"}\nLed by Dr. Wesley Francillon, Papillon Engineering is a dynamic hub for engineering education and related projects. Drawing on a Ph.D. in Materials Science and over two decades of cross-sector experience spanning private industry, federal government, and academia, our mission is to make complex systems accessible. \n\nAs an Associate Professor teaching Engineering Science and Electrical Engineering Technology, Dr. Francillon bridges the gap between classroom theory and real-world implementation, guiding hands-on undergraduate projects and fostering the next generation of STEM professionals through robust K-12 outreach.\n:::\n\n<!-- Controlled image column (from 8 to 7) with max-height and shadow -->\n::: {.g-col-12 .g-col-md-7 style=\"text-align: center; padding: 20px;\"}\n<img src=\"Papillon2.jpg\" alt=\"Papillon Engineering Logo\" style=\"max-width: 100%; max-height: 380px; border-radius: 16px; object-fit: contain; box-shadow: 0 10px 25px rgba(0,0,0,0.15);\">\n:::\n\n:::\n\n<!-- ========================================== -->\n<!-- LIVE RSS FEED SECTION                      -->\n<!-- ========================================== -->\n\n<div style=\"margin-top: 60px; padding-top: 30px; border-top: 2px solid #e2e8f0;\">\n  <h2 style=\"font-size: 1.7rem; font-weight: 800; color: #1e1b4b; margin-bottom: 8px;\">Live Engineering & Materials Feed</h2>\n  \n  <p style=\"font-size: 1.05rem; color: #475569; margin-bottom: 25px; line-height: 1.6;\">\n    <em>Curated daily from IEEE Spectrum, MIT Mechanical Engineering, and Phys.org Materials Science.</em><br>\n    <strong style=\"color: #0f172a;\">Interested in creating an automated RSS feed aggregator as a Python project?</strong> \n    <a href=\"rss_feeds.html\" style=\"color: #4338ca; font-weight: 700; text-decoration: none;\">Build this automated Python syndication pipeline here →</a>\n  </p>\n\n  <!-- Feed Cards Container -->\n  <div id=\"rss-feed-container\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;\">\n    <!-- JavaScript will inject cards here -->\n    <div style=\"color: #64748b; font-style: italic;\">Fetching latest engineering headlines...</div>\n  </div>\n</div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  // Target RSS Feeds\n  const feeds = [\n    { name: \"IEEE Spectrum (Electrical)\", url: \"https://spectrum.ieee.org/feeds/feed.rss\" },\n    { name: \"MIT News (Mechanical)\", url: \"https://news.mit.edu/rss/topic/mechanical-engineering\" },\n    { name: \"Phys.org (Materials Science)\", url: \"https://phys.org/rss-feed/nanotech-news/materials-science/\" }\n  ];\n\n  const container = document.getElementById(\"rss-feed-container\");\n  container.innerHTML = \"\"; // clear loading text\n\n  feeds.forEach(feed => {\n    // Use rss2json proxy to bypass CORS restrictions in static HTML\n    const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed.url)}&api_key=`;\n    \n    fetch(apiUrl)\n      .then(response => response.json())\n      .then(data => {\n        if (data.status === 'ok') {\n          // Grab the top 2 articles from this feed\n          const articles = data.items.slice(0, 2);\n          \n          articles.forEach(item => {\n            // Clean up descriptions (remove HTML tags and truncate)\n            let cleanDesc = item.description.replace(/<[^>]*>?/gm, '');\n            if (cleanDesc.length > 120) cleanDesc = cleanDesc.substring(0, 120) + \"...\";\n            \n            // Format publish date\n            const pubDate = new Date(item.pubDate).toLocaleDateString(\"en-US\", { month: 'short', day: 'numeric', year: 'numeric' });\n\n            // Create card HTML\n            const card = document.createElement(\"div\");\n            card.style.cssText = \"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: transform 0.2s;\";\n            card.onmouseover = () => card.style.transform = \"translateY(-4px)\";\n            card.onmouseout = () => card.style.transform = \"translateY(0)\";\n            \n            card.innerHTML = `\n              <div style=\"font-size: 0.75rem; font-weight: 700; color: #4338ca; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;\">${feed.name}</div>\n              <h3 style=\"font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0 0 10px 0; line-height: 1.4;\">\n                <a href=\"${item.link}\" target=\"_blank\" style=\"color: inherit; text-decoration: none;\">${item.title}</a>\n              </h3>\n              <p style=\"font-size: 0.9rem; color: #64748b; margin: 0 0 15px 0; line-height: 1.5;\">${cleanDesc}</p>\n              <div style=\"font-size: 0.8rem; color: #94a3b8; font-weight: 500;\">📅 ${pubDate}</div>\n            `;\n            container.appendChild(card);\n          });\n        }\n      })\n      .catch(error => console.error(\"Error fetching feed:\", error));\n  });\n});\n</script>","srcMarkdownNoYaml":"\n\n<div class=\"welcome-headline\" style=\"font-size: 2.2rem; font-weight: 800; color: #1e1b4b; margin-bottom: 5px;\">\nWelcome to Papillon Engineering\n</div>\n<div class=\"welcome-subheadline\" style=\"font-size: 1.1rem; color: #64748b; margin-bottom: 30px;\">\nPractical Insights into Materials, Circuits, Engineering Science & Empowering the Next Generation of Engineers\n</div>\n\n::: {.grid .align-items-center}\n\n<!-- Expanded text column slightly (from 4 to 5) for better vertical balance -->\n::: {.g-col-12 .g-col-md-5 style=\"background-color: #f8f9fa; padding: 30px; border-radius: 12px; border: 1px solid #e2e8f0; font-size: 1.05rem; line-height: 1.6;\"}\nLed by Dr. Wesley Francillon, Papillon Engineering is a dynamic hub for engineering education and related projects. Drawing on a Ph.D. in Materials Science and over two decades of cross-sector experience spanning private industry, federal government, and academia, our mission is to make complex systems accessible. \n\nAs an Associate Professor teaching Engineering Science and Electrical Engineering Technology, Dr. Francillon bridges the gap between classroom theory and real-world implementation, guiding hands-on undergraduate projects and fostering the next generation of STEM professionals through robust K-12 outreach.\n:::\n\n<!-- Controlled image column (from 8 to 7) with max-height and shadow -->\n::: {.g-col-12 .g-col-md-7 style=\"text-align: center; padding: 20px;\"}\n<img src=\"Papillon2.jpg\" alt=\"Papillon Engineering Logo\" style=\"max-width: 100%; max-height: 380px; border-radius: 16px; object-fit: contain; box-shadow: 0 10px 25px rgba(0,0,0,0.15);\">\n:::\n\n:::\n\n<!-- ========================================== -->\n<!-- LIVE RSS FEED SECTION                      -->\n<!-- ========================================== -->\n\n<div style=\"margin-top: 60px; padding-top: 30px; border-top: 2px solid #e2e8f0;\">\n  <h2 style=\"font-size: 1.7rem; font-weight: 800; color: #1e1b4b; margin-bottom: 8px;\">Live Engineering & Materials Feed</h2>\n  \n  <p style=\"font-size: 1.05rem; color: #475569; margin-bottom: 25px; line-height: 1.6;\">\n    <em>Curated daily from IEEE Spectrum, MIT Mechanical Engineering, and Phys.org Materials Science.</em><br>\n    <strong style=\"color: #0f172a;\">Interested in creating an automated RSS feed aggregator as a Python project?</strong> \n    <a href=\"rss_feeds.html\" style=\"color: #4338ca; font-weight: 700; text-decoration: none;\">Build this automated Python syndication pipeline here →</a>\n  </p>\n\n  <!-- Feed Cards Container -->\n  <div id=\"rss-feed-container\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;\">\n    <!-- JavaScript will inject cards here -->\n    <div style=\"color: #64748b; font-style: italic;\">Fetching latest engineering headlines...</div>\n  </div>\n</div>\n\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  // Target RSS Feeds\n  const feeds = [\n    { name: \"IEEE Spectrum (Electrical)\", url: \"https://spectrum.ieee.org/feeds/feed.rss\" },\n    { name: \"MIT News (Mechanical)\", url: \"https://news.mit.edu/rss/topic/mechanical-engineering\" },\n    { name: \"Phys.org (Materials Science)\", url: \"https://phys.org/rss-feed/nanotech-news/materials-science/\" }\n  ];\n\n  const container = document.getElementById(\"rss-feed-container\");\n  container.innerHTML = \"\"; // clear loading text\n\n  feeds.forEach(feed => {\n    // Use rss2json proxy to bypass CORS restrictions in static HTML\n    const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(feed.url)}&api_key=`;\n    \n    fetch(apiUrl)\n      .then(response => response.json())\n      .then(data => {\n        if (data.status === 'ok') {\n          // Grab the top 2 articles from this feed\n          const articles = data.items.slice(0, 2);\n          \n          articles.forEach(item => {\n            // Clean up descriptions (remove HTML tags and truncate)\n            let cleanDesc = item.description.replace(/<[^>]*>?/gm, '');\n            if (cleanDesc.length > 120) cleanDesc = cleanDesc.substring(0, 120) + \"...\";\n            \n            // Format publish date\n            const pubDate = new Date(item.pubDate).toLocaleDateString(\"en-US\", { month: 'short', day: 'numeric', year: 'numeric' });\n\n            // Create card HTML\n            const card = document.createElement(\"div\");\n            card.style.cssText = \"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: transform 0.2s;\";\n            card.onmouseover = () => card.style.transform = \"translateY(-4px)\";\n            card.onmouseout = () => card.style.transform = \"translateY(0)\";\n            \n            card.innerHTML = `\n              <div style=\"font-size: 0.75rem; font-weight: 700; color: #4338ca; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;\">${feed.name}</div>\n              <h3 style=\"font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0 0 10px 0; line-height: 1.4;\">\n                <a href=\"${item.link}\" target=\"_blank\" style=\"color: inherit; text-decoration: none;\">${item.title}</a>\n              </h3>\n              <p style=\"font-size: 0.9rem; color: #64748b; margin: 0 0 15px 0; line-height: 1.5;\">${cleanDesc}</p>\n              <div style=\"font-size: 0.8rem; color: #94a3b8; font-weight: 500;\">📅 ${pubDate}</div>\n            `;\n            container.appendChild(card);\n          });\n        }\n      })\n      .catch(error => console.error(\"Error fetching feed:\", error));\n  });\n});\n</script>"},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":false,"echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,